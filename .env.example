# ==============================================================================
# ACME AI Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' to customize local/remote AI settings.
# Note: Vite requires environment variables to begin with 'VITE_' to be exposed.
# Never commit real credentials, tokens, or private keys to source control.
# ==============================================================================

# Base URL of the local AI engine (e.g. http://localhost:8000 or http://127.0.0.1:11434)
# Leave empty to run in interactive Demo / Mock mode for UI testing.
VITE_AI_API_BASE_URL=

# Chat completion endpoint path on your engine server
# Default fallback: /chat/completions (or /api/chat depending on your engine)
VITE_AI_API_CHAT_PATH=/chat/completions

# Model identifier (e.g. local-model, llama3, or custom local model)
VITE_AI_MODEL_NAME=

# Optional API key or bearer token (leave blank if not required for local engine)
VITE_AI_API_KEY=

# Force demo mode even if an endpoint is configured (true / false)
VITE_ENABLE_DEMO_MODE=false
